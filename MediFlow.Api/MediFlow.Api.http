GET {{MediFlow.Api_HostAddress}}/api/clinics
Authorization: Bearer {{token}}
Accept: application/json

### Create Clinic
POST {{MediFlow.Api_HostAddress}}/api/clinics
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json
{
  "name": "Clinic 1"
}

### Update Clinic
PUT {{MediFlow.Api_HostAddress}}/api/clinics/{{ClinicId}}
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json
{
  "name": ""
}

### Set Clinic Availability 
PUT {{MediFlow.Api_HostAddress}}/api/clinics/6c2a20e1-656b-4a9a-bca7-ce3f99d8dafe/availability
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json
{
  "availabilities": [
    {
      "day": 1,
      "timeRanges": [
        { "from": "6:00", "to": "5:00" },
        { "from": "18:00", "to": "23:00" }
      ]
    }
  ]
}

### Add Doctor To Clinic  
POST {{MediFlow.Api_HostAddress}}/api/clinics/{{ClinicId}}/doctors
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json
{
  "doctorId" : "4863f72f-f219-4881-a7d5-7215573a2760"
}

### Add Medicine
POST {{MediFlow.Api_HostAddress}}/api/clinics/{{ClinicId}}/medicines
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json
{
  "name": "M 4",
  "price": 30,
  "quantity": 21
}

### Update Medicine
Put {{MediFlow.Api_HostAddress}}/api/clinics/{{ClinicId}}/medicines/{{MedicineId}}
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json
{
  "name": "M 3 - update name",
  "price": 30,
  "quantity": 21
}

### Delete Medicine
Delete {{MediFlow.Api_HostAddress}}/api/clinics/{{ClinicId}}/medicines/{{MedicineId}}
Authorization: Bearer {{token}}
Accept: application/json

### Add Equipment
POST {{MediFlow.Api_HostAddress}}/api/clinics/{{ClinicId}}/equipments
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json
{
  "name": "E 1",
   "fees": 30
}

### Update Equipment
Put {{MediFlow.Api_HostAddress}}/api/clinics/{{ClinicId}}/equipments/{{EquipmentId}}
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json
{
  "name": "E1 - update name",
  "fees": 40
}

### Delete Equipment
Delete {{MediFlow.Api_HostAddress}}/api/clinics/{{ClinicId}}/equipments/{{EquipmentId}}
Authorization: Bearer {{token}}
Accept: application/json


### Add Room
POST {{MediFlow.Api_HostAddress}}/api/clinics/{{ClinicId}}/rooms
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json
{
  "name": "R 2"
}

### Update Room
Put {{MediFlow.Api_HostAddress}}/api/clinics/{{ClinicId}}/rooms/{{RoomId}}
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json
{
  "name": "R1 - update name"
}

### Delete Room
Delete {{MediFlow.Api_HostAddress}}/api/clinics/{{ClinicId}}/rooms/{{RoomId}}
Authorization: Bearer {{token}}
Accept: application/json