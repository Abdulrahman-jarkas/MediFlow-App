@MediFlow.Api_HostAddress = https://localhost:7218
@Token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..K_vawgFZJLPF3I960cRSHjXA9LX8QvHlklzumGUS6zc
@DoctorId = 20d491ce-c4a9-42a1-be2e-3237f841d740


GET {{MediFlow.Api_HostAddress}}/api/doctors
Authorization: Bearer {{token}}
Accept: application/json

### Create Doctor
POST {{MediFlow.Api_HostAddress}}/api/doctors
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json
{
  "name": "Doctor 1"
}

### Update Doctor
PUT {{MediFlow.Api_HostAddress}}/api/doctors/{{DoctorId}}
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json
{
  "name": "Doctor 1"
}

### Set Doctor Availability 
PUT {{MediFlow.Api_HostAddress}}/api/doctors/a345e307-9080-4fd5-8e59-106ad1a44a01/availability
Authorization: Bearer {{token}}
Accept: application/json
Content-Type: application/json
{
  "availabilities": [
    {
      "day": 1,
      "timeRanges": [
        { "from": "01:30", "to": "4:00" },
        { "from": "6:00", "to": "10:00" }
      ]
    },
    {
      "day": 2,
      "timeRanges": [
        { "from": "09:00", "to": "12:00" }
      ]
    }
  ]
}