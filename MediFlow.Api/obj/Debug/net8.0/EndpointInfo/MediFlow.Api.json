              "$ref": "#/components/schemas/TimeRangeRequest"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "TimeRangeRequest": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "format": "time"
          },
          "to": {
            "type": "string",
            "format": "time"
          }
        },
        "additionalProperties": false
      },
