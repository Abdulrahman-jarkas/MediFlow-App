        "additionalProperties": false
      },
      "DayOfWeek": {
        "enum": [
          0,
          1,
          2,
          3,
          4,
          5,
          6
        ],
        "type": "integer",
        "format": "int32"
      },
      "SetAvailabilityRequest": {
        "type": "object",
        "properties": {
          "availabilities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SingleDayAvailabilityRequest"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "SingleDayAvailabilityRequest": {
        "type": "object",
        "properties": {
          "day": {
            "$ref": "#/components/schemas/DayOfWeek"
