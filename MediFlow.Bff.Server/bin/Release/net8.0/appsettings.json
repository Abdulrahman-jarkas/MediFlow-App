{
  "OpenIDConnectSettings": {
    "Authority": "https://localhost:5001",
    "ClientId": "mediflowclient",
    "ClientSecret": "secret"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "apiProxy": {
        "ClusterId": "downstreamApi",
        "Match": {
          "Path": "/bff/{**catchall}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/bff"
          }
        ]
      }
    },
    "Clusters": {
      "downstreamApi": {
        "HttpClient": {
          "SslProtocols": [
            "Tls12"
          ]
        },
        "Destinations": {
          "default": {
            "Address": "https://localhost:7218/"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
